---
import Base from "../layouts/Base.astro";
import JoinButton from "../components/JoinButton.astro";
import HeroShowcase from "../components/HeroShowcase.astro";
import { site } from "../lib/site";
import { artworkCredit } from "../lib/pokemon";

const bullets = ["Preço comparado", "Cupons", "Atualização diária"];
---

<Base>
  <header class="border-b border-ink/10">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-1 px-5 py-4 text-center">
      <p class="font-display text-sm font-semibold tracking-wide text-ink sm:text-base">
        {site.name}
      </p>
      <p class="text-xs text-muted sm:text-sm">Gratuito · Vagas Ilimitadas</p>
    </div>
  </header>

  <main id="conteudo">
    <section class="relative overflow-hidden">
      <div class="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-8 text-center sm:py-12 lg:py-16">
        <HeroShowcase />

        <p class="mt-6 font-display text-sm text-flame">Grupo de ofertas no WhatsApp</p>
        <h1 class="mt-2 font-display text-[clamp(1.7rem,7vw,3.4rem)] font-semibold leading-[1.08] text-ink">
          Ofertas de Pokémon TCG com preço comparado
        </h1>
        <p class="measure mx-auto mt-4 text-base leading-relaxed text-muted sm:text-lg">
          O grupo seleciona booster, box, acessórios, sleeves, coleções, cupons e ofertas do dia e manda no WhatsApp quando o preço faz sentido.
        </p>

        <ul class="mt-5 flex flex-wrap justify-center gap-2" aria-label="O que o grupo entrega">
          {
            bullets.map((item) => (
              <li class="rounded-sm border border-flame/40 bg-surface px-3 py-1.5 text-sm text-ink">
                {item}
              </li>
            ))
          }
        </ul>

        <div class="mt-7 flex w-full max-w-sm flex-col items-center gap-3 sm:mt-8">
          <JoinButton class="w-full" />
          <p class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
            <a class="cta-ghost" href={site.partnerStore} target="_blank" rel="noopener noreferrer">
              Loja no Mercado Livre
            </a>
            <a class="cta-ghost" href={site.whatsappPersonalOrder} target="_blank" rel="noopener noreferrer">
              Pedido no privado
            </a>
          </p>
        </div>

        <div class="mt-10 w-full border-t border-ink/10 pt-8">
          <h2 class="font-display text-lg font-semibold text-ink">Lojas que acompanhamos</h2>
          <p class="measure mx-auto mt-2 text-sm leading-relaxed text-muted sm:text-base">
            O grupo monitora ofertas nessas plataformas. A compra é no vendedor, não no grupo.
          </p>
          <ul class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Lojas monitoradas">
            <li>
              <span class="store-pill">Amazon</span>
            </li>
            <li>
              <a
                class="store-pill store-pill-link"
                href={site.partnerStore}
                target="_blank"
                rel="noopener noreferrer"
              >
                Mercado Livre
              </a>
            </li>
            <li>
              <span class="store-pill">Magalu</span>
            </li>
            <li>
              <span class="store-pill">Shopee</span>
            </li>
            <li>
              <span class="store-pill">e muito mais</span>
            </li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <footer class="border-t border-ink/10">
    <div class="mx-auto max-w-xl space-y-4 px-5 py-8 text-center">
      <p class="text-sm leading-relaxed text-muted">
        A compra é no vendedor, nas plataformas. O {site.name} só compartilha ofertas.
      </p>
      <p class="text-xs leading-relaxed text-muted/80">{artworkCredit}</p>
      <p class="text-sm text-muted">© {new Date().getFullYear()} {site.name}</p>
    </div>
  </footer>

  <div class="sticky-cta lg:hidden">
    <JoinButton class="w-full" />
  </div>
</Base>
