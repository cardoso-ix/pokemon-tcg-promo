---
import Base from "../layouts/Base.astro";
import JoinButton from "../components/JoinButton.astro";
import HeroShowcase from "../components/HeroShowcase.astro";
import { site } from "../lib/site";
import { artworkCredit } from "../lib/pokemon";

const bullets = ["Preço comparado", "Cupons relâmpago", "Atualização diária", "Frete Full"];
---

<Base>
  <header class="border-b border-ink/10">
    <div class="mx-auto flex max-w-3xl flex-col items-center gap-1 px-5 py-4 text-center">
      <p class="font-display text-sm font-semibold tracking-wide text-ink sm:text-base">
        {site.name}
      </p>
      <p class="text-xs text-muted sm:text-sm">Acesso 100% Gratuito · Grupo VIP no WhatsApp</p>
    </div>
  </header>

  <main id="conteudo">
    <!-- Hero Section -->
    <section class="relative overflow-hidden">
      <div class="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-8 text-center sm:py-12 lg:py-16">
        <HeroShowcase />

        <p class="mt-6 font-display text-sm font-semibold uppercase tracking-wider text-flame">
          ⚡ Grupo de Ofertas no WhatsApp
        </p>
        <h1 class="mt-2 font-display text-[clamp(1.7rem,7vw,3.4rem)] font-bold leading-[1.08] text-ink">
          Ofertas de Pokémon TCG com preço comparado
        </h1>
        <p class="measure mx-auto mt-4 text-base leading-relaxed text-muted sm:text-lg">
          Monitore Booster Boxes, Triple Packs, Latas, Sleeves e Cupons no Mercado Livre e Amazon. Receba alertas imediatos direto no seu celular antes que esgote!
        </p>

        <ul class="mt-5 flex flex-wrap justify-center gap-2" aria-label="O que o grupo entrega">
          {
            bullets.map((item) => (
              <li class="rounded-sm border border-flame/40 bg-surface px-3 py-1.5 text-sm font-medium text-ink">
                {item}
              </li>
            ))
          }
        </ul>

        <!-- Prova Social e Vagas Limitadas -->
        <div class="mt-6 flex w-full max-w-sm flex-col items-center gap-2 rounded-sm border border-flame/30 bg-surface/90 p-3.5 text-center shadow-sm">
          <div class="flex items-center gap-2 text-xs font-semibold uppercase tracking-wider text-flame">
            <span class="inline-block h-2 w-2 rounded-full bg-emerald-500 animate-pulse"></span>
            Grupo 1 Aberto · Mais de 250 Colecionadores
          </div>
          <div class="w-full bg-ink/10 rounded-full h-2 overflow-hidden p-0.5">
            <div class="bg-gradient-to-r from-emerald-500 via-amber-500 to-flame h-full w-[26%] rounded-full"></div>
          </div>
          <p class="text-[11px] text-muted">
            Vagas gratuitas abertas antes do teto de capacidade do Grupo 1.
          </p>
        </div>

        <div class="mt-4 flex w-full max-w-sm flex-col items-center gap-3 sm:mt-5">
          <JoinButton class="w-full text-base sm:text-lg" label="Entrar no Grupo no WhatsApp" />
          <p class="flex flex-wrap justify-center gap-x-4 gap-y-1 text-sm">
            <a class="cta-ghost" href={site.partnerStore} target="_blank" rel="noopener noreferrer">
              Loja no Mercado Livre
            </a>
            <a class="cta-ghost" href={site.whatsappPersonalOrder} target="_blank" rel="noopener noreferrer">
              Pedido no privado
            </a>
          </p>
        </div>
      </div>
    </section>

    <!-- Benefícios & Como Funciona (Sem Formulário) -->
    <section class="relative border-t border-ink/10 bg-surface/40 py-10 sm:py-14">
      <div class="mx-auto max-w-3xl px-5 text-center">
        <h2 class="font-display text-2xl font-bold text-ink sm:text-3xl">
          Como funciona o Grupo VIP?
        </h2>
        <p class="measure mx-auto mt-2 text-sm text-muted sm:text-base">
          Direto ao ponto, sem burocracia ou conversa fiada. Só promoção real e verificada.
        </p>

        <div class="mt-8 grid grid-cols-1 gap-4 text-left sm:grid-cols-3">
          <div class="rounded-sm border border-ink/10 bg-surface p-5">
            <div class="text-2xl">⚡</div>
            <h3 class="mt-2 font-display text-base font-bold text-ink">1. Curadoria 24h</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Rastreamos as maiores lojas e avisamos no mesmo instante em que o preço cai ou entra em liquidação.
            </p>
          </div>

          <div class="rounded-sm border border-ink/10 bg-surface p-5">
            <div class="text-2xl">🎟️</div>
            <h3 class="mt-2 font-display text-base font-bold text-ink">2. Cupons Exclusivos</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Códigos de cupons relâmpago do Mercado Livre testados e validados para você aplicar no carrinho.
            </p>
          </div>

          <div class="rounded-sm border border-ink/10 bg-surface p-5">
            <div class="text-2xl">🔇</div>
            <h3 class="mt-2 font-display text-base font-bold text-ink">3. Grupo Silencioso</h3>
            <p class="mt-1 text-sm leading-relaxed text-muted">
              Apenas os administradores enviam ofertas. Zero conversas paralelas ou spam, 100% foco em economizar.
            </p>
          </div>
        </div>

        <div class="mt-6 inline-flex items-center gap-2 rounded-sm border border-ink/10 bg-surface px-4 py-2.5 text-xs text-muted">
          <span>🛡️</span>
          <span><strong>Combate ao Cambismo:</strong> Apenas produtos lacrados com nota fiscal e lojas oficiais da Copag no Mercado Livre.</span>
        </div>

        <div class="mt-8 flex justify-center">
          <JoinButton class="w-full max-w-sm text-base" label="Acessar Grupo VIP Grátis" />
        </div>
      </div>
    </section>

    <!-- Lojas Acompanhadas -->
    <section class="relative overflow-hidden">
      <div class="relative mx-auto flex max-w-3xl flex-col items-center px-5 py-8 text-center sm:py-12">
        <div class="w-full">
          <h2 class="font-display text-lg font-semibold text-ink">Lojas e Marketplaces Acompanhados</h2>
          <p class="measure mx-auto mt-2 text-sm leading-relaxed text-muted sm:text-base">
            O grupo monitora e compara ofertas nessas plataformas. A compra é realizada com total segurança direto no vendedor.
          </p>
          <ul class="mt-4 flex flex-wrap justify-center gap-2" aria-label="Lojas monitoradas">
            <li><span class="store-pill">Mercado Livre</span></li>
            <li><span class="store-pill">Amazon</span></li>
            <li><span class="store-pill">Magalu</span></li>
            <li><span class="store-pill">Shopee</span></li>
            <li><span class="store-pill">e lojas especializadas</span></li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <!-- Rodapé com Compliance e Políticas -->
  <footer class="border-t border-ink/10 bg-surface/30">
    <div class="mx-auto max-w-2xl space-y-4 px-5 py-8 text-center">
      <p class="text-xs leading-relaxed text-muted">
        <strong>Aviso de Isenção:</strong> As transações e pagamentos ocorrem diretamente nas plataformas de destino (Mercado Livre, Amazon, etc.). O {site.name} atua exclusivamente na curadoria e divulgação de ofertas como participante de programas de afiliados.
      </p>
      <p class="text-[11px] leading-relaxed text-muted/75">
        Este site e este serviço não possuem qualquer vínculo comercial, patrocínio ou endosso oficial da <em>Meta Platforms, Inc.</em> (Facebook, Instagram, WhatsApp) ou da <em>Nintendo / The Pokémon Company / Creatures Inc. / GAME FREAK inc.</em> Todos os nomes, logos e personagens citados são marcas registradas de seus respectivos detentores.
      </p>
      <p class="text-xs leading-relaxed text-muted/80">{artworkCredit}</p>
      
      <div class="flex flex-wrap justify-center gap-4 pt-2 text-xs text-muted">
        <a class="hover:text-ink underline" href="/privacidade">Política de Privacidade</a>
        <span>·</span>
        <a class="hover:text-ink underline" href="/termos">Termos de Uso</a>
        <span>·</span>
        <a class="hover:text-ink underline" href={site.whatsappPersonalOrder} target="_blank" rel="noopener noreferrer">Fale Conosco</a>
      </div>

      <p class="pt-2 text-xs text-muted">© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</p>
    </div>
  </footer>

  <!-- Barra Fixa Mobile CTA -->
  <div class="sticky-cta lg:hidden">
    <JoinButton class="w-full text-base" label="Entrar no Grupo no WhatsApp" />
  </div>
</Base>
