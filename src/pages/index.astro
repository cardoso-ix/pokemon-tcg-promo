---
import Base from "../layouts/Base.astro";
import JoinButton from "../components/JoinButton.astro";
import CardWallBackground from "../components/CardWallBackground.astro";
import { site } from "../lib/site";
---

<Base>
  <!-- Mosaico de Cartas Reais de Pokémon TCG Ofuscadas no Fundo -->
  <CardWallBackground />

  <!-- Auras e Luzes Neon Sutis -->
  <div aria-hidden="true" class="pointer-events-none fixed inset-0 z-0 overflow-hidden">
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[600px] h-[600px] rounded-full bg-amber-500/10 blur-[150px]"></div>
    <div class="absolute top-[40%] left-1/2 -translate-x-1/2 w-[500px] h-[500px] rounded-full bg-cyan-500/10 blur-[140px]"></div>
    <div class="absolute bottom-0 left-1/2 -translate-x-1/2 w-[550px] h-[550px] rounded-full bg-emerald-500/10 blur-[150px]"></div>
    <div class="absolute inset-0 bg-tech-grid"></div>
  </div>

  <!-- Header Superior Minimalista Centralizado -->
  <header class="relative z-10 border-b border-white/[0.08] bg-[#070d1e]/85 backdrop-blur-md sticky top-0">
    <div class="mx-auto max-w-4xl px-5 py-3.5 flex items-center justify-between">
      <div class="flex items-center gap-2.5">
        <img 
          src="/brand/logo-grupo-pokemon-tcg-promo.png" 
          alt="Logo Pokémon TCG Promo" 
          class="w-9 h-9 rounded-full object-cover ring-2 ring-yellow-400/50 shadow-[0_0_12px_rgba(250,204,21,0.4)]"
        />
        <div>
          <span class="font-display font-bold text-base tracking-wide text-white block leading-tight">{site.name}</span>
          <span class="text-[10px] text-slate-400 font-medium">Grupo VIP de Ofertas</span>
        </div>
      </div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/25 text-emerald-400 font-mono text-[11px] font-semibold">
          <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-livedot"></span>
          Acesso Gratuito
        </span>
      </div>
    </div>
  </header>

  <!-- Conteúdo Principal 100% Centralizado -->
  <main id="conteudo" class="relative z-10">

    <!-- HERO SECTION CENTRALIZADO -->
    <section class="px-5 pt-8 pb-12 sm:pt-14 sm:pb-16 lg:pt-20 lg:pb-24 text-center">
      <div class="mx-auto max-w-3xl flex flex-col items-center justify-center">

        <!-- LOGO OFICIAL DO GRUPO NO CENTRO (MEDALHÃO COM AURA) -->
        <div class="relative mb-6 sm:mb-8 group">
          <!-- Auras de Brilho Dourado e Fogo ao Redor da Logo -->
          <div aria-hidden="true" class="absolute -inset-4 bg-gradient-to-r from-amber-500/40 via-orange-500/35 to-yellow-400/40 rounded-full blur-2xl opacity-80 group-hover:opacity-100 transition-opacity"></div>
          
          <div class="relative w-36 h-36 sm:w-44 sm:h-44 md:w-52 md:h-52 rounded-full p-[3.5px] bg-gradient-to-br from-amber-200 via-yellow-400 to-amber-600 shadow-[0_0_50px_rgba(250,204,21,0.5),0_20px_40px_rgba(0,0,0,0.8)] animate-float">
            <img 
              src="/brand/logo-grupo-pokemon-tcg-promo.png" 
              alt="Logo Oficial Pokémon TCG Promo com Charizard" 
              class="w-full h-full object-cover rounded-full select-none"
              loading="eager"
              fetchpriority="high"
            />
          </div>

          <!-- Badge Flutuante Oficial -->
          <div class="absolute -bottom-2 left-1/2 -translate-x-1/2 whitespace-nowrap">
            <span class="px-3.5 py-1 rounded-full bg-[#070d1e] border border-amber-400/50 text-amber-300 font-display font-bold text-[10px] sm:text-[11px] uppercase tracking-wider shadow-lg backdrop-blur-md flex items-center gap-1">
              <span>✨</span> Comunidade Oficial
            </span>
          </div>
        </div>

        <!-- Badge de Status Dinâmico -->
        <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 font-mono text-[11px] sm:text-xs font-semibold uppercase tracking-wider mb-4">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-livedot"></span>
          <span>⚡ Grupo VIP Oficial · Vagas Abertas Hoje</span>
        </div>

        <!-- Título Principal 100% Centralizado -->
        <h1 class="font-display font-bold text-4xl sm:text-6xl lg:text-7xl leading-[0.95] tracking-tight text-white max-w-2xl">
          Pokémon
          <span class="block text-gradient-gold drop-shadow-[0_0_40px_rgba(250,204,21,0.5)] mt-1.5">
            TCG Promo
          </span>
        </h1>

        <!-- Subtítulo Centralizado -->
        <p class="mt-5 text-base sm:text-lg text-slate-300 max-w-xl leading-relaxed">
          Monitore <strong class="text-white">Booster Boxes, Triple Packs, Latas e Sleeves</strong> com preço comparado e cupons relâmpago no Mercado Livre e Amazon. Receba alertas imediatos antes que esgote!
        </p>

        <!-- BOTÃO PRINCIPAL DO WHATSAPP CENTRALIZADO COM RADAR PULSE E SHIMMER -->
        <div class="w-full max-w-md mt-7 sm:mt-8">
          <JoinButton class="w-full" label="ENTRAR NO GRUPO VIP GRÁTIS" sublabel="⚡ Alertas imediatos antes que esgote" size="lg" />

          <!-- Micro-Garantias de Confiança -->
          <div class="mt-4 flex items-center justify-center gap-5 text-xs text-slate-400">
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/></svg>
              100% Grátis · Sem Cadastro
            </span>
            <span class="flex items-center gap-1.5">
              <svg class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
              Silencioso · Zero Spam
            </span>
          </div>
        </div>

        <!-- BARRA DE PROVA SOCIAL E DINÂMICA AO VIVO CENTRALIZADA -->
        <div class="mt-8 w-full max-w-xl">
          <div class="rounded-2xl border border-white/[0.08] bg-white/[0.03] p-1.5 backdrop-blur-md">
            <div class="grid grid-cols-1 sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-white/[0.06] text-xs">
              
              <div class="flex items-center justify-center gap-2 py-2.5 px-3">
                <span class="text-base">🔥</span>
                <span class="font-medium text-slate-200">328+ Colecionadores</span>
                <span class="flex items-center gap-1 rounded-full bg-red-500/15 px-1.5 py-0.5 font-mono text-[9px] font-bold uppercase text-red-400">
                  <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-livedot"></span>
                  Ao vivo
                </span>
              </div>

              <div class="flex items-center justify-center gap-2 py-2.5 px-3">
                <span class="text-base">⚡</span>
                <span class="font-medium text-slate-200">Preço Comparado</span>
              </div>

              <div class="flex items-center justify-center gap-2 py-2.5 px-3">
                <span class="text-base">🎟️</span>
                <span class="font-medium text-slate-200">Cupons Exclusivos</span>
              </div>

            </div>
          </div>
        </div>

      </div>
    </section>

    <!-- SEÇÃO DE BENEFÍCIOS CENTRALIZADA -->
    <section class="border-t border-white/[0.08] bg-[#0d152a]/70 py-12 sm:py-16 px-5 relative backdrop-blur-sm">
      <div class="mx-auto max-w-4xl text-center">
        
        <div class="max-w-xl mx-auto mb-10">
          <span class="font-mono text-cyan-400 text-xs uppercase tracking-widest font-semibold block mb-2">Por que fazer parte?</span>
          <h2 class="font-display text-2xl sm:text-3xl font-bold text-white">Só o que importa para quem coleciona e joga</h2>
          <p class="text-slate-400 text-sm mt-2">Sem spam, sem conversas paralelas. Alertas rápidos de liquidação em lojas confiáveis.</p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-5 text-left">
          
          <!-- Card 1: Curadoria 24h -->
          <div class="relative rounded-2xl border border-cyan-500/20 bg-white/[0.02] p-6 backdrop-blur-sm hover:border-cyan-500/40 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-cyan-400 to-sky-600 flex items-center justify-center text-slate-950 text-xl font-bold mb-4 shadow-[0_0_20px_rgba(34,230,255,0.35)]">
              ⚡
            </div>
            <h3 class="font-display font-bold text-lg text-white">1. Curadoria 24 Horas</h3>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">
              Robôs monitoram as maiores lojas e avisam no segundo exato em que o preço cai ou entra em promoção relâmpago.
            </p>
          </div>

          <!-- Card 2: Cupons Secretos -->
          <div class="relative rounded-2xl border border-amber-500/20 bg-white/[0.02] p-6 backdrop-blur-sm hover:border-amber-500/40 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-amber-300 to-yellow-500 flex items-center justify-center text-slate-950 text-xl font-bold mb-4 shadow-[0_0_20px_rgba(250,204,21,0.35)]">
              🎟️
            </div>
            <h3 class="font-display font-bold text-lg text-white">2. Cupons Validados</h3>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">
              Códigos de cupons do Mercado Livre e Amazon testados previamente para você aplicar e economizar no carrinho.
            </p>
          </div>

          <!-- Card 3: Grupo Silencioso -->
          <div class="relative rounded-2xl border border-emerald-500/20 bg-white/[0.02] p-6 backdrop-blur-sm hover:border-emerald-500/40 transition-colors">
            <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-emerald-400 to-emerald-600 flex items-center justify-center text-slate-950 text-xl font-bold mb-4 shadow-[0_0_20px_rgba(37,211,102,0.35)]">
              🔇
            </div>
            <h3 class="font-display font-bold text-lg text-white">3. Grupo 100% Silencioso</h3>
            <p class="mt-2 text-sm text-slate-300 leading-relaxed">
              Apenas os administradores enviam ofertas. Zero conversas paralelas, zero bom dia. Foco total em economizar.
            </p>
          </div>

        </div>

        <!-- Segundo Botão CTA Centralizado -->
        <div class="mt-10 flex justify-center">
          <div class="w-full max-w-md">
            <JoinButton class="w-full" label="ACESSAR GRUPO VIP GRÁTIS" sublabel="⚡ Alertas imediatos no WhatsApp" size="lg" />
          </div>
        </div>

      </div>
    </section>

    <!-- SEÇÃO DE PLATAFORMAS MONITORADAS CENTRALIZADA -->
    <section class="py-10 px-5 text-center">
      <div class="mx-auto max-w-3xl">
        <h3 class="font-display text-sm font-semibold text-slate-300 uppercase tracking-wider">Lojas e Marketplaces Acompanhados</h3>
        <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">Compre com total segurança diretamente no aplicativo das lojas oficiais.</p>
        
        <div class="mt-5 flex flex-wrap justify-center gap-2.5">
          <span class="px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.04] text-xs font-medium text-slate-200">Mercado Livre (Frete Full)</span>
          <span class="px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.04] text-xs font-medium text-slate-200">Amazon Brasil (Prime)</span>
          <span class="px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.04] text-xs font-medium text-slate-200">Magalu</span>
          <span class="px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.04] text-xs font-medium text-slate-200">Shopee</span>
          <span class="px-3.5 py-1.5 rounded-xl border border-white/10 bg-white/[0.04] text-xs font-medium text-slate-200">Lojas Oficiais Copag</span>
        </div>
      </div>
    </section>

  </main>

  <!-- RODAPÉ INSTITUCIONAL CENTRALIZADO -->
  <footer class="border-t border-white/[0.08] bg-[#050a17] px-5 pt-10 pb-28 md:pb-10 relative z-10 text-xs text-slate-400 text-center">
    <div class="mx-auto max-w-4xl">
      <div class="flex flex-col items-center justify-center gap-4">
        <div>
          <span class="font-display font-bold text-base text-white">Pokémon <span class="text-amber-300">TCG Promo</span></span>
          <p class="text-slate-400 text-xs mt-1">Curadoria e alertas de cartas Pokémon no WhatsApp.</p>
        </div>
        <div class="flex flex-wrap justify-center gap-4 text-slate-400">
          <a href={site.partnerStore} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">Loja no Mercado Livre</a>
          <span>·</span>
          <a href={site.whatsappPersonalOrder} target="_blank" rel="noopener noreferrer" class="hover:text-cyan-300 transition-colors">Fale Conosco</a>
          <span>·</span>
          <a href="/privacidade" class="hover:text-cyan-300 transition-colors">Privacidade</a>
          <span>·</span>
          <a href="/termos" class="hover:text-cyan-300 transition-colors">Termos</a>
        </div>
      </div>

      <div class="mt-8 pt-6 border-t border-white/[0.05] space-y-2 text-[11px] leading-relaxed text-slate-500 max-w-2xl mx-auto">
        <p><strong>Aviso de Isenção:</strong> As transações e pagamentos ocorrem diretamente nas plataformas de destino (Mercado Livre, Amazon, etc.). O {site.name} atua exclusivamente na curadoria e divulgação de ofertas como participante de programas de afiliados oficiais.</p>
        <p>Este site e este serviço não possuem qualquer vínculo comercial, patrocínio ou endosso oficial da Meta Platforms, Inc. (Facebook, Instagram, WhatsApp) ou da Nintendo / The Pokémon Company / Creatures Inc. / GAME FREAK inc. Pokémon é marca registrada de seus respectivos detentores.</p>
        <p class="pt-2 text-slate-600">© {new Date().getFullYear()} {site.name}. Todos os direitos reservados.</p>
      </div>
    </div>
  </footer>

  <!-- STICKY BOTTOM CTA FIXO NO MOBILE -->
  <div class="sticky-cta lg:hidden">
    <JoinButton class="w-full" label="ENTRAR NO GRUPO VIP GRÁTIS" sublabel="" size="md" />
  </div>
</Base>
