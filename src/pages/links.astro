---
// Página "link na bio": reúne os canais (grupo, Instagram, TikTok) numa tela só.
// Independente da landing: não usa o Base.astro nem o global.css; só reaproveita o OrigemTracker (page_view).
import OrigemTracker from "../components/OrigemTracker.astro";
import { site } from "../lib/site";

const titulo = `${site.name} | Links`;
const descricao = "Grupo de ofertas de cartas Pokémon, Instagram e TikTok do Pokémon TCG Promo.";

// utm_medium=bio: o rastreador da landing atribui a entrada no grupo à bio
const botoes = [
  {
    id: "grupo",
    texto: "Grupo de promoção",
    sub: "Entre no grupo VIP do WhatsApp",
    href: "/?utm_source=instagram&utm_medium=bio&utm_campaign=links",
    icone: "grupo",
    destaque: true,
  },
  {
    id: "instagram",
    texto: "Instagram",
    sub: "@pokemon_tcg_promo",
    href: "https://www.instagram.com/pokemon_tcg_promo/",
    icone: "instagram",
  },
  {
    id: "tiktok",
    texto: "TikTok",
    sub: "@pokemon_tcg_promo",
    href: "https://www.tiktok.com/@pokemon_tcg_promo",
    icone: "tiktok",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#7cc8f0" />
    <link rel="canonical" href={`${site.url}/links`} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${site.url}/brand/logo-grupo-pokemon-tcg-promo.png`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tektur:wght@600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Cenário ilustrado próprio: céu, sol, nuvens, morros e grama (SVG, sem arte de terceiros) -->
    <div class="cena" aria-hidden="true">
      <svg viewBox="0 0 400 800" preserveAspectRatio="xMidYMax slice">
        <defs>
          <linearGradient id="ceu" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5fb4ec" />
            <stop offset="0.55" stop-color="#a9dcf5" />
            <stop offset="1" stop-color="#e9f7e2" />
          </linearGradient>
          <radialGradient id="sol" cx="0.5" cy="0.5" r="0.5">
            <stop offset="0" stop-color="#fff6c9" />
            <stop offset="0.45" stop-color="#ffe27a" stop-opacity="0.9" />
            <stop offset="1" stop-color="#ffe27a" stop-opacity="0" />
          </radialGradient>
          <linearGradient id="morro1" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#9fd889" />
            <stop offset="1" stop-color="#6fbf62" />
          </linearGradient>
          <linearGradient id="morro2" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#7cc962" />
            <stop offset="1" stop-color="#4ea849" />
          </linearGradient>
          <linearGradient id="morro3" x1="0" y1="0" x2="0" y2="1">
            <stop offset="0" stop-color="#5cb84a" />
            <stop offset="1" stop-color="#2f8a3a" />
          </linearGradient>
        </defs>
        <rect width="400" height="800" fill="url(#ceu)" />
        <circle cx="318" cy="120" r="110" fill="url(#sol)" />
        <g fill="#ffffff" opacity="0.92">
          <g class="nuvem n1"><ellipse cx="70" cy="150" rx="46" ry="17" /><ellipse cx="96" cy="138" rx="28" ry="20" /><ellipse cx="52" cy="142" rx="22" ry="14" /></g>
          <g class="nuvem n2"><ellipse cx="250" cy="250" rx="54" ry="18" /><ellipse cx="276" cy="236" rx="30" ry="22" /><ellipse cx="230" cy="240" rx="24" ry="15" /></g>
          <g class="nuvem n3"><ellipse cx="120" cy="330" rx="36" ry="12" /><ellipse cx="138" cy="321" rx="20" ry="14" /></g>
        </g>
        <path d="M0 560 Q90 500 190 540 T400 520 V800 H0Z" fill="url(#morro1)" />
        <path d="M0 620 Q120 570 230 610 T400 600 V800 H0Z" fill="url(#morro2)" />
        <path d="M0 690 Q110 650 210 680 T400 670 V800 H0Z" fill="url(#morro3)" />
        <g fill="#2a7a33">
          <path d="M30 720 l4 -18 l4 18Z M60 740 l3 -14 l3 14Z M340 705 l4 -17 l4 17Z M370 735 l3 -13 l3 13Z M190 760 l4 -16 l4 16Z" />
        </g>
        <g>
          <circle cx="48" cy="745" r="5" fill="#ffd34d" /><circle cx="48" cy="745" r="2" fill="#f08a24" />
          <circle cx="356" cy="728" r="5" fill="#ff8fb1" /><circle cx="356" cy="728" r="2" fill="#fff3a8" />
          <circle cx="214" cy="772" r="4" fill="#ffffff" /><circle cx="214" cy="772" r="1.6" fill="#ffd34d" />
          <circle cx="110" cy="770" r="4" fill="#ffd34d" /><circle cx="110" cy="770" r="1.6" fill="#f08a24" />
        </g>
      </svg>
    </div>

    <main>
      <header>
        <img
          class="avatar"
          src="/brand/logo-grupo-pokemon-tcg-promo-96.webp"
          srcset="/brand/logo-grupo-pokemon-tcg-promo-96.webp 1x, /brand/logo-grupo-pokemon-tcg-promo.webp 2x"
          width="96"
          height="96"
          alt="Logo Pokémon TCG Promo"
        />
        <h1>{site.name}</h1>
        <p>Ofertas de cartas Pokémon todo dia</p>
      </header>

      <nav aria-label="Links">
        {
          botoes.map((b) => (
            <a
              class:list={["botao", { destaque: b.destaque }]}
              href={b.href}
              data-botao={b.id}
              rel={b.href.startsWith("http") ? "noopener" : undefined}
            >
              <span class="icone" aria-hidden="true">
                {b.icone === "grupo" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
                )}
                {b.icone === "instagram" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM12 3.8c2.7 0 3 0 4 .1 2.7.1 4 1.4 4.1 4.1.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4-4.1 4.1-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1-.1-1.3-.1-4s0-3 .1-4C4 5.3 5.3 4 8 3.9c1-.1 1.3-.1 4-.1ZM12 2c-2.7 0-3.1 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15.1 2 14.7 2 12 2Z"/></svg>
                )}
                {b.icone === "tiktok" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .8.1V9.1a6.3 6.3 0 1 0 5.5 6.3V8.6a8 8 0 0 0 4.4 1.4V6.6A4.6 4.6 0 0 1 16.6 2Z"/></svg>
                )}
              </span>
              <span class="textos">
                <strong>{b.texto}</strong>
                <small>{b.sub}</small>
              </span>
              <span class="seta" aria-hidden="true">›</span>
            </a>
          ))
        }
      </nav>

      <footer>Pokémon TCG Promo · ofertas no Mercado Livre</footer>
    </main>

    <OrigemTracker />

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        min-height: 100svh;
        font-family: Inter, system-ui, sans-serif;
        color: #12324a;
        background: #a9dcf5;
        -webkit-font-smoothing: antialiased;
      }
      .cena { position: fixed; inset: 0; z-index: 0; }
      .cena svg { width: 100%; height: 100%; display: block; }
      .nuvem { animation: deriva 26s ease-in-out infinite alternate; }
      .n2 { animation-duration: 34s; }
      .n3 { animation-duration: 22s; }
      @keyframes deriva { to { transform: translateX(24px); } }
      @media (prefers-reduced-motion: reduce) { .nuvem { animation: none; } }

      main {
        position: relative;
        z-index: 1;
        max-width: 440px;
        margin: 0 auto;
        padding: 44px 16px 32px;
        display: flex;
        flex-direction: column;
        gap: 26px;
      }
      header { text-align: center; }
      .avatar {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 6px 18px rgba(18, 50, 74, 0.25);
        background: #fff;
        object-fit: cover;
      }
      h1 {
        margin: 12px 0 4px;
        font-family: Tektur, Inter, sans-serif;
        font-size: 1.7rem;
        letter-spacing: 0.01em;
        color: #fff;
        text-shadow: 0 2px 0 #1f6fa3, 0 4px 12px rgba(18, 50, 74, 0.35);
      }
      header p {
        margin: 0;
        font-weight: 600;
        color: #12324a;
        background: rgba(255, 255, 255, 0.7);
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
      }
      nav { display: flex; flex-direction: column; gap: 14px; }
      .botao {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 66px;
        padding: 10px 16px 10px 10px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.92);
        color: #12324a;
        text-decoration: none;
        box-shadow: 0 4px 0 rgba(18, 50, 74, 0.18), 0 8px 20px rgba(18, 50, 74, 0.12);
        border: 2px solid #fff;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .botao:hover { transform: translateY(-2px); }
      .botao:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(18, 50, 74, 0.18); }
      .botao:focus-visible { outline: 3px solid #1f6fa3; outline-offset: 3px; }
      .botao.destaque { background: #ffd93d; border-color: #fff3a8; }
      .icone {
        flex: none;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: #fff;
      }
      .icone svg { width: 26px; height: 26px; }
      [data-botao="grupo"] .icone { background: #25d366; }
      [data-botao="instagram"] .icone { background: linear-gradient(45deg, #f9a825, #e91e63 55%, #8e24aa); }
      [data-botao="tiktok"] .icone { background: #111; }
      .textos { flex: 1; display: flex; flex-direction: column; min-width: 0; }
      .textos strong { font-size: 1.05rem; font-weight: 700; }
      .textos small { font-size: 0.82rem; color: #3d5a70; font-weight: 500; }
      .destaque .textos small { color: #5a4300; }
      .seta { font-size: 1.8rem; line-height: 1; color: #1f6fa3; }
      footer {
        text-align: center;
        font-size: 0.78rem;
        font-weight: 600;
        color: #fff;
        text-shadow: 0 1px 3px rgba(0, 0, 0, 0.35);
        margin-top: 8px;
      }
    </style>
  </body>
</html>
