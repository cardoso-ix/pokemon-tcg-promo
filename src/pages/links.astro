---
// Página "link na bio": reúne os canais (grupos 01 e 02, site, Instagram, TikTok) numa tela só.
// Independente da landing: não usa o Base.astro nem o global.css; só reaproveita o OrigemTracker (page_view e clique_grupo).
import OrigemTracker from "../components/OrigemTracker.astro";
import { site } from "../lib/site";

const titulo = `${site.name} | Links`;
const descricao = "Grupos de ofertas de cartas Pokémon, Instagram e TikTok do Pokémon TCG Promo.";

// Convites diretos dos grupos (o clique em chat.whatsapp.com conta como clique_grupo no OrigemTracker, página /links)
const grupos = [
  { id: "grupo01", texto: "Grupo 01", href: "https://chat.whatsapp.com/IFxkHX9ADT29EIUHRkCHVo" },
  { id: "grupo02", texto: "Grupo 02", href: "https://chat.whatsapp.com/BlW2Wq7JYE0AP7FeIJHiMP" },
];

// utm_medium=bio: o rastreador da landing atribui a visita do site à bio
const botoes = [
  {
    id: "site",
    texto: "Site oficial",
    sub: "pokemontcgpromo.online",
    href: "/?utm_source=instagram&utm_medium=bio&utm_campaign=links",
    icone: "site",
  },
  {
    id: "instagram",
    texto: "Instagram",
    sub: "@pokemon_tcg_promo",
    href: "https://www.instagram.com/pokemon_tcg_promo/",
    icone: "instagram",
  },
  {
    id: "tiktok",
    texto: "TikTok",
    sub: "@pokemon_tcg_promo",
    href: "https://www.tiktok.com/@pokemon_tcg_promo",
    icone: "tiktok",
  },
];

const WA =
  "M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z";
const ICONES: Record<string, string> = {
  site: "M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4a14 14 0 0 1 1.9 4h-3.8A14 14 0 0 1 12 4ZM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3Zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16Zm3-8h-3a8 8 0 0 1 4.4-3.6A15.7 15.7 0 0 0 8.1 8ZM12 20a14 14 0 0 1-1.9-4h3.8A14 14 0 0 1 12 20Zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4Zm.2 5.6a15.7 15.7 0 0 0 1.4-3.6h3a8 8 0 0 1-4.4 3.6Zm1.8-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z",
  instagram: "M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM12 3.8c2.7 0 3 0 4 .1 2.7.1 4 1.4 4.1 4.1.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4-4.1 4.1-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1-.1-1.3-.1-4s0-3 .1-4C4 5.3 5.3 4 8 3.9c1-.1 1.3-.1 4-.1ZM12 2c-2.7 0-3.1 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15.1 2 14.7 2 12 2Z",
  tiktok: "M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .8.1V9.1a6.3 6.3 0 1 0 5.5 6.3V8.6a8 8 0 0 0 4.4 1.4V6.6A4.6 4.6 0 0 1 16.6 2Z",
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#0b2233" />
    <link rel="canonical" href={`${site.url}/links`} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${site.url}/brand/logo-grupo-pokemon-tcg-promo.png`} />
    <link rel="icon" type="image/svg+xml" href="/links/favicon.svg" />
    <link rel="preload" as="image" href="/links/fundo.jpg" media="(max-aspect-ratio: 3/4)" />
    <link rel="preload" as="image" href="/links/fundo-pc.jpg" media="(min-aspect-ratio: 3/4)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tektur:wght@600;700&family=Inter:wght@500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Fundo: compilado dos vídeos do canal (Bulbasaur, Charmander e Squirtle e evoluções, feitos com IA), mudo e em loop.
         A imagem (poster) aparece na hora; o vídeo (2,6 MB) toca enquanto baixa. Sem vídeo em modo economia de dados; no computador toca fundo-pc.mp4 (1920x1080). -->
    <div class="cena" aria-hidden="true">
      <video id="fundo" muted loop playsinline preload="none" poster="/links/fundo.jpg">
        <source src="/links/fundo.mp4" type="video/mp4" />
      </video>
    </div>

    <main>
      <header>
        <div class="logos">
          <img class="logo l1" src="/links/logo-charizard.webp" width="128" height="128" alt="Logo Pokémon TCG Promo com Charizard" />
          <img class="logo l2" src="/links/logo-blastoise.webp" width="128" height="128" alt="Logo Pokémon TCG Promo com Blastoise" />
        </div>
        <h1>{site.name}</h1>
        <p class="frase">Ofertas de cartas Pokémon todo dia</p>
      </header>

      <nav aria-label="Links">
        <p class="rotulo">Grupos de promoção no WhatsApp</p>
        <div class="par">
          {
            grupos.map((g) => (
              <a class="botao vip" href={g.href} data-botao={g.id} rel="noopener">
                <span class="icone wa" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d={WA} /></svg>
                </span>
                <span class="textos">
                  <strong>{g.texto}</strong>
                  <small>Entrar grátis</small>
                </span>
              </a>
            ))
          }
        </div>
        {
          botoes.map((b) => (
            <a class="botao vidro" href={b.href} data-botao={b.id} rel={b.href.startsWith("http") ? "noopener" : undefined}>
              <span class="icone" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path fill="currentColor" d={ICONES[b.icone]} /></svg>
              </span>
              <span class="textos">
                <strong>{b.texto}</strong>
                <small>{b.sub}</small>
              </span>
              <span class="seta" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" /></svg>
              </span>
            </a>
          ))
        }
      </nav>

      <footer>
        <strong>Pokémon TCG Promo</strong> · ofertas no Mercado Livre
        <small>© 2026 Pokémon TCG Promo. Site independente, sem vínculo com Nintendo, The Pokémon Company, Creatures, GAME FREAK ou Meta. Pokémon é marca registrada de seus detentores.</small>
      </footer>
    </main>

    <script is:inline>
      // Vídeo só depois da página pronta e fora do modo economia de dados/2G; o poster cobre até lá.
      (function () {
        var v = document.getElementById("fundo");
        if (!v) return;
        var c = navigator.connection || {};
        if (c.saveData || /(^|-)2g$/.test(c.effectiveType || "")) return;
        if (window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        // computador (tela deitada): vídeo largo próprio (fundo-pc.mp4, 1920x1080); a imagem fundo-pc.jpg cobre até ele tocar
        if (window.matchMedia && window.matchMedia("(min-aspect-ratio: 3/4)").matches) {
          v.removeAttribute("poster");
          v.src = "/links/fundo-pc.mp4";
          v.addEventListener("playing", function () { v.className = "pronto"; });
        }
        function tocar() {
          v.preload = "auto";
          var p = v.play();
          if (p && p.catch) p.catch(function () {});
        }
        if (document.readyState === "complete") tocar();
        else window.addEventListener("load", tocar);
      })();
    </script>

    <OrigemTracker />

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        min-height: 100svh;
        font-family: Inter, system-ui, sans-serif;
        color: #fff;
        background: #0b2233;
        -webkit-font-smoothing: antialiased;
      }

      /* Fundo: no celular o vídeo cobre a tela; no computador vira um painel 9:16 no centro,
         com a imagem desfocada nas laterais (sem esticar o vídeo e sem pixelar). */
      .cena { position: fixed; inset: 0; z-index: 0; overflow: hidden; background: #0b2233; }
      .cena video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .cena::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(6, 20, 32, 0.55) 0%, rgba(6, 20, 32, 0.2) 40%, rgba(6, 20, 32, 0.75) 100%);
      }
      /* Computador/tela deitada: vídeo largo próprio (fundo-pc.mp4) com a imagem fundo-pc.jpg por baixo até ele tocar */
      @media (min-aspect-ratio: 3/4) {
        .cena { background: #0b2233 url("/links/fundo-pc.jpg") center 30% / cover no-repeat; }
        .cena video { opacity: 0; transition: opacity 0.6s ease; }
        .cena video.pronto { opacity: 1; }
        .cena::after { background: radial-gradient(ellipse 420px 100% at 50% 50%, rgba(6, 20, 32, 0.55), rgba(6, 20, 32, 0.15) 100%), linear-gradient(180deg, rgba(6, 20, 32, 0.35), rgba(6, 20, 32, 0.1) 40%, rgba(6, 20, 32, 0.55)); }
      }

      main {
        position: relative;
        z-index: 1;
        max-width: 440px;
        margin: 0 auto;
        padding: 26px 16px 18px;
        min-height: 100svh;
        display: flex;
        flex-direction: column;
        gap: 22px;
      }

      header { text-align: center; }
      .logos { display: flex; justify-content: center; align-items: center; }
      .logo {
        width: 128px;
        height: 128px;
        border-radius: 50%;
        box-shadow: 0 10px 28px rgba(0, 0, 0, 0.45), 0 0 0 3px rgba(255, 255, 255, 0.85);
        animation: flutua 4s ease-in-out infinite;
      }
      .l1 { transform: rotate(-6deg); margin-right: -14px; z-index: 1; }
      .l2 { transform: rotate(6deg); animation-delay: -2s; }
      @keyframes flutua {
        0%, 100% { translate: 0 0; }
        50% { translate: 0 -6px; }
      }
      h1 {
        margin: 14px 0 6px;
        font-family: Tektur, Inter, sans-serif;
        font-size: 1.8rem;
        letter-spacing: 0.01em;
        text-shadow: 0 2px 0 #1f6fa3, 0 4px 14px rgba(0, 0, 0, 0.5);
      }
      .frase {
        margin: 0;
        display: inline-block;
        padding: 5px 14px;
        border-radius: 999px;
        font-weight: 600;
        font-size: 0.92rem;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.3);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
      }

      nav { display: flex; flex-direction: column; gap: 12px; margin-top: auto; }
      .rotulo {
        margin: 0 0 -2px;
        text-align: center;
        font-size: 0.78rem;
        font-weight: 800;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        text-shadow: 0 1px 6px rgba(0, 0, 0, 0.6);
      }

      .botao {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 64px;
        padding: 9px 14px 9px 9px;
        border-radius: 20px;
        text-decoration: none;
        color: inherit;
        overflow: hidden;
        transition: transform 0.18s ease, background 0.18s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .botao:hover { transform: translateY(-2px); }
      .botao:active { transform: scale(0.98); }
      .botao:focus-visible { outline: 3px solid #ffd93d; outline-offset: 3px; }

      /* Grupos: amarelo-laranja com brilho que atravessa e pulso de luz (piscando) */
      .par { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .vip {
        gap: 10px;
        padding: 9px 10px 9px 9px;
        color: #2b1a00;
        background: linear-gradient(135deg, #fff07a 0%, #ffd23d 45%, #ff9f1c 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 6px 18px rgba(255, 170, 30, 0.45);
        animation: pisca 1.3s ease-in-out infinite;
      }
      .vip::after {
        content: "";
        position: absolute;
        top: 0;
        bottom: 0;
        left: -60%;
        width: 40%;
        background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.75), transparent);
        transform: skewX(-20deg);
        animation: brilho 2.6s ease-in-out infinite;
      }
      .par .vip:nth-child(2) { animation-delay: 0.65s; }
      .par .vip:nth-child(2)::after { animation-delay: 1.3s; }
      @keyframes pisca {
        0%, 100% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 0 0 0 rgba(255, 210, 61, 0.9); filter: brightness(1); }
        50% { box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7), 0 0 0 9px rgba(255, 210, 61, 0); filter: brightness(1.15); }
      }
      @keyframes brilho {
        0%, 55% { left: -60%; }
        100% { left: 130%; }
      }
      .vip .icone { width: 40px; height: 40px; border-radius: 50%; background: #25d366; box-shadow: 0 2px 6px rgba(0, 0, 0, 0.25); }
      .vip .icone svg { width: 23px; height: 23px; }
      .vip strong { font-size: 1.08rem; font-weight: 800; }
      .vip .textos small { color: #5a3a00; font-weight: 600; }

      /* Demais botões: vidro fosco sobre o vídeo */
      .vidro {
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.28);
        backdrop-filter: blur(14px) saturate(1.3);
        -webkit-backdrop-filter: blur(14px) saturate(1.3);
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.25);
      }
      .vidro:hover { background: rgba(255, 255, 255, 0.22); }

      .icone {
        flex: none;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: #fff;
        position: relative;
        z-index: 1;
      }
      .icone svg { width: 25px; height: 25px; }
      [data-botao="site"] .icone { background: linear-gradient(135deg, #3aa0e0, #1f5fa3); }
      [data-botao="instagram"] .icone { background: linear-gradient(45deg, #f9a825, #e91e63 55%, #8e24aa); }
      [data-botao="tiktok"] .icone { background: #111; box-shadow: -2px -2px 0 #25f4ee inset, 2px 2px 0 #fe2c55 inset; }
      .textos { flex: 1; display: flex; flex-direction: column; min-width: 0; position: relative; z-index: 1; }
      .textos strong { font-size: 1.04rem; font-weight: 700; }
      .textos small { font-size: 0.8rem; font-weight: 500; color: rgba(255, 255, 255, 0.78); }
      .seta { width: 22px; height: 22px; color: rgba(255, 255, 255, 0.85); }
      .seta svg { width: 100%; height: 100%; display: block; }

      footer {
        text-align: center;
        font-size: 0.8rem;
        color: rgba(255, 255, 255, 0.92);
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.6);
        padding-top: 4px;
      }
      footer small { display: block; margin-top: 4px; font-size: 0.66rem; line-height: 1.4; color: rgba(255, 255, 255, 0.68); }

      @media (prefers-reduced-motion: reduce) {
        .logo, .vip, .vip::after { animation: none; }
      }
    </style>
  </body>
</html>
