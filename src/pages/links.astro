---
// Página "link na bio": reúne os canais (grupos 01 e 02, site, Instagram, TikTok) numa tela só.
// Independente da landing: não usa o Base.astro nem o global.css; só reaproveita o OrigemTracker (page_view).
import OrigemTracker from "../components/OrigemTracker.astro";
import { site } from "../lib/site";

const titulo = `${site.name} | Links`;
const descricao = "Grupos de ofertas de cartas Pokémon, Instagram e TikTok do Pokémon TCG Promo.";

// Convites diretos dos grupos (o clique em chat.whatsapp.com conta como clique_grupo no OrigemTracker, página /links)
const grupos = [
  { id: "grupo01", texto: "Grupo 01", href: "https://chat.whatsapp.com/IFxkHX9ADT29EIUHRkCHVo" },
  { id: "grupo02", texto: "Grupo 02", href: "https://chat.whatsapp.com/BlW2Wq7JYE0AP7FeIJHiMP" },
];

// utm_medium=bio: o rastreador da landing atribui a visita do site à bio
const botoes = [
  {
    id: "site",
    texto: "Site oficial",
    sub: "pokemontcgpromo.online",
    href: "/?utm_source=instagram&utm_medium=bio&utm_campaign=links",
    icone: "site",
    destaque: false,
  },
  {
    id: "instagram",
    texto: "Instagram",
    sub: "@pokemon_tcg_promo",
    href: "https://www.instagram.com/pokemon_tcg_promo/",
    icone: "instagram",
  },
  {
    id: "tiktok",
    texto: "TikTok",
    sub: "@pokemon_tcg_promo",
    href: "https://www.tiktok.com/@pokemon_tcg_promo",
    icone: "tiktok",
  },
];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <meta name="theme-color" content="#7cc8f0" />
    <link rel="canonical" href={`${site.url}/links`} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:image" content={`${site.url}/brand/logo-grupo-pokemon-tcg-promo.png`} />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Tektur:wght@600;700&family=Inter:wght@500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <!-- Fundo: compilado dos vídeos do canal (Bulbasaur, Charmander e Squirtle e evoluções, feitos com IA), mudo e em loop -->
    <div class="cena" aria-hidden="true">
      <video autoplay muted loop playsinline preload="auto" poster="/links/fundo.jpg">
        <source src="/links/fundo.mp4" type="video/mp4" />
      </video>
    </div>

    <div class="topo">
      <strong>Pokémon TCG Promo</strong> · ofertas no Mercado Livre
      <small>© 2026 Pokémon TCG Promo. Site independente, sem vínculo com Nintendo, The Pokémon Company, Creatures, GAME FREAK ou Meta. Pokémon é marca registrada de seus detentores.</small>
    </div>

    <main>
      <header>
        <img
          class="avatar"
          src="/brand/logo-grupo-pokemon-tcg-promo-96.webp"
          srcset="/brand/logo-grupo-pokemon-tcg-promo-96.webp 1x, /brand/logo-grupo-pokemon-tcg-promo.webp 2x"
          width="96"
          height="96"
          alt="Logo Pokémon TCG Promo"
        />
        <h1>{site.name}</h1>
        <p>Ofertas de cartas Pokémon todo dia</p>
      </header>

      <nav aria-label="Links">
        <p class="rotulo">Grupos de promoção no WhatsApp</p>
        <div class="par">
          {
            grupos.map((g) => (
              <a class="botao destaque vip" href={g.href} data-botao={g.id} rel="noopener">
                <span class="icone wa" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8s-.4-.1-.6.1-.7.8-.8 1-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.3-.4.7-1.3a.5.5 0 0 0 0-.4l-.8-1.9c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6a2.7 2.7 0 0 0 1.8-1.2 2.2 2.2 0 0 0 .1-1.3c0-.1-.2-.2-.5-.3Z"/></svg>
                </span>
                <span class="textos">
                  <strong>{g.texto}</strong>
                  <small>Entrar grátis</small>
                </span>
              </a>
            ))
          }
        </div>
        {
          botoes.map((b) => (
            <a
              class:list={["botao", { destaque: b.destaque }]}
              href={b.href}
              data-botao={b.id}
              rel={b.href.startsWith("http") ? "noopener" : undefined}
            >
              <span class="icone" aria-hidden="true">
                {b.icone === "site" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm6.9 6h-3a15.7 15.7 0 0 0-1.4-3.6A8 8 0 0 1 18.9 8ZM12 4a14 14 0 0 1 1.9 4h-3.8A14 14 0 0 1 12 4ZM4.3 14a8.2 8.2 0 0 1 0-4h3.4a16.5 16.5 0 0 0 0 4H4.3Zm.8 2h3a15.7 15.7 0 0 0 1.4 3.6A8 8 0 0 1 5.1 16Zm3-8h-3a8 8 0 0 1 4.4-3.6A15.7 15.7 0 0 0 8.1 8ZM12 20a14 14 0 0 1-1.9-4h3.8A14 14 0 0 1 12 20Zm2.3-6H9.7a14.7 14.7 0 0 1 0-4h4.6a14.7 14.7 0 0 1 0 4Zm.2 5.6a15.7 15.7 0 0 0 1.4-3.6h3a8 8 0 0 1-4.4 3.6Zm1.8-5.6a16.5 16.5 0 0 0 0-4h3.4a8.2 8.2 0 0 1 0 4h-3.4Z"/></svg>
                )}
                {b.icone === "instagram" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M12 7a5 5 0 1 0 0 10 5 5 0 0 0 0-10Zm0 8.2a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4ZM17.3 5.5a1.2 1.2 0 1 0 0 2.4 1.2 1.2 0 0 0 0-2.4ZM12 3.8c2.7 0 3 0 4 .1 2.7.1 4 1.4 4.1 4.1.1 1 .1 1.3.1 4s0 3-.1 4c-.1 2.7-1.4 4-4.1 4.1-1 .1-1.3.1-4 .1s-3 0-4-.1c-2.7-.1-4-1.4-4.1-4.1-.1-1-.1-1.3-.1-4s0-3 .1-4C4 5.3 5.3 4 8 3.9c1-.1 1.3-.1 4-.1ZM12 2c-2.7 0-3.1 0-4.1.1C4.3 2.2 2.2 4.3 2.1 7.9 2 8.9 2 9.3 2 12s0 3.1.1 4.1c.1 3.6 2.2 5.7 5.8 5.8 1 .1 1.4.1 4.1.1s3.1 0 4.1-.1c3.6-.1 5.7-2.2 5.8-5.8.1-1 .1-1.4.1-4.1s0-3.1-.1-4.1c-.1-3.6-2.2-5.7-5.8-5.8C15.1 2 14.7 2 12 2Z"/></svg>
                )}
                {b.icone === "tiktok" && (
                  <svg viewBox="0 0 24 24"><path fill="currentColor" d="M16.6 2h-3.4v13.4a2.9 2.9 0 1 1-2.9-2.9c.3 0 .6 0 .8.1V9.1a6.3 6.3 0 1 0 5.5 6.3V8.6a8 8 0 0 0 4.4 1.4V6.6A4.6 4.6 0 0 1 16.6 2Z"/></svg>
                )}
              </span>
              <span class="textos">
                <strong>{b.texto}</strong>
                <small>{b.sub}</small>
              </span>
              <span class="seta" aria-hidden="true">›</span>
            </a>
          ))
        }
      </nav>

    </main>

    <OrigemTracker />

    <style is:global>
      * { box-sizing: border-box; }
      html, body { margin: 0; }
      body {
        min-height: 100svh;
        font-family: Inter, system-ui, sans-serif;
        color: #12324a;
        background: #0b2233;
        -webkit-font-smoothing: antialiased;
      }
      .cena { position: fixed; inset: 0; z-index: 0; }
      .cena video { width: 100%; height: 100%; object-fit: cover; display: block; }
      .cena::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(180deg, rgba(6, 20, 32, 0.55) 0%, rgba(6, 20, 32, 0.25) 45%, rgba(6, 20, 32, 0.6) 100%);
      }
      .topo {
        position: relative;
        z-index: 2;
        padding: 10px 16px 9px;
        text-align: center;
        font-size: 0.82rem;
        color: #fff;
        background: rgba(6, 20, 32, 0.72);
        border-bottom: 1px solid rgba(255, 255, 255, 0.15);
      }
      .topo small { display: block; margin-top: 3px; font-size: 0.66rem; line-height: 1.35; color: rgba(255, 255, 255, 0.72); }
      @keyframes pisca {
        0%, 100% { box-shadow: 0 4px 0 rgba(18, 50, 74, 0.18), 0 0 0 0 rgba(255, 217, 61, 0.85); filter: brightness(1); }
        50% { box-shadow: 0 4px 0 rgba(18, 50, 74, 0.18), 0 0 0 10px rgba(255, 217, 61, 0); filter: brightness(1.12); }
      }

      main {
        position: relative;
        z-index: 1;
        max-width: 440px;
        margin: 0 auto;
        padding: 22px 16px 28px;
        min-height: calc(100svh - 92px);
        display: flex;
        flex-direction: column;
        gap: 26px;
      }
      header { text-align: center; }
      .avatar {
        width: 84px;
        height: 84px;
        border-radius: 50%;
        border: 4px solid #fff;
        box-shadow: 0 6px 18px rgba(18, 50, 74, 0.25);
        background: #fff;
        object-fit: cover;
      }
      h1 {
        margin: 12px 0 4px;
        font-family: Tektur, Inter, sans-serif;
        font-size: 1.7rem;
        letter-spacing: 0.01em;
        color: #fff;
        text-shadow: 0 2px 0 #1f6fa3, 0 4px 12px rgba(18, 50, 74, 0.35);
      }
      header p {
        margin: 0;
        font-weight: 600;
        color: #12324a;
        background: rgba(255, 255, 255, 0.7);
        display: inline-block;
        padding: 4px 12px;
        border-radius: 999px;
      }
      nav { display: flex; flex-direction: column; gap: 14px; margin-top: auto; }
      .botao {
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 66px;
        padding: 10px 16px 10px 10px;
        border-radius: 18px;
        background: rgba(255, 255, 255, 0.92);
        color: #12324a;
        text-decoration: none;
        box-shadow: 0 4px 0 rgba(18, 50, 74, 0.18), 0 8px 20px rgba(18, 50, 74, 0.12);
        border: 2px solid #fff;
        transition: transform 0.15s ease, box-shadow 0.15s ease;
        -webkit-tap-highlight-color: transparent;
      }
      .botao:hover { transform: translateY(-2px); }
      .botao:active { transform: translateY(2px); box-shadow: 0 1px 0 rgba(18, 50, 74, 0.18); }
      .botao:focus-visible { outline: 3px solid #1f6fa3; outline-offset: 3px; }
      .botao.destaque { background: #ffd93d; border-color: #fff3a8; animation: pisca 1.2s ease-in-out infinite; }
      .icone {
        flex: none;
        width: 46px;
        height: 46px;
        border-radius: 14px;
        display: grid;
        place-items: center;
        color: #fff;
      }
      .icone svg { width: 26px; height: 26px; }
      .icone.wa { background: #25d366; }
      [data-botao="site"] .icone { background: #1f6fa3; }
      .rotulo {
        margin: 0 0 -4px;
        text-align: center;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: #fff;
        text-shadow: 0 1px 4px rgba(0, 0, 0, 0.5);
      }
      .par { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
      .vip { padding: 10px 12px 10px 10px; gap: 10px; }
      .vip .icone { width: 40px; height: 40px; border-radius: 12px; }
      .vip .icone svg { width: 23px; height: 23px; }
      .par .vip:nth-child(2) { animation-delay: 0.6s; }
      [data-botao="instagram"] .icone { background: linear-gradient(45deg, #f9a825, #e91e63 55%, #8e24aa); }
      [data-botao="tiktok"] .icone { background: #111; }
      .textos { flex: 1; display: flex; flex-direction: column; min-width: 0; }
      .textos strong { font-size: 1.05rem; font-weight: 700; }
      .textos small { font-size: 0.82rem; color: #3d5a70; font-weight: 500; }
      .destaque .textos small { color: #5a4300; }
      .seta { font-size: 1.8rem; line-height: 1; color: #1f6fa3; }
    </style>
  </body>
</html>
