---
import Base from "../layouts/Base.astro";
import QualifyForm from "../components/QualifyForm.astro";
import { site } from "../lib/site";

if (!site.leadQuenteEnabled) {
  return Astro.redirect(import.meta.env.BASE_URL);
}
---

<Base
  title={`Entrar no grupo — ${site.name}`}
  description="Responda se você já compra Pokémon TCG. Só quem já compra recebe o convite do grupo de ofertas."
>
  <main id="conteudo" class="py-10 sm:py-14">
    <QualifyForm heading="Libera o grupo se você já compra TCG" />
    <p class="px-5 pb-10 text-center">
      <a class="cta-ghost" href={import.meta.env.BASE_URL}>Voltar ao início</a>
    </p>
  </main>
</Base>
