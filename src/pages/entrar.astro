---
import Base from "../layouts/Base.astro";
import QualifyForm from "../components/QualifyForm.astro";
import { site } from "../lib/site";

if (!site.leadQuenteEnabled) {
  return Astro.redirect(import.meta.env.BASE_URL);
}
---

<Base
  title={`Entrar no grupo — ${site.name}`}
  description="Acesse o grupo de ofertas de Pokémon TCG no WhatsApp. Promoções selecionadas e preço comparado."
>
  <main id="conteudo" class="py-10 sm:py-14">
    <QualifyForm
      heading="Acesse o grupo de ofertas no WhatsApp"
      subheading="Preencha para receber o convite e ser avisado das melhores promoções antes de esgotar."
    />
    <p class="px-5 pb-10 text-center">
      <a class="cta-ghost" href={import.meta.env.BASE_URL}>Voltar à página inicial</a>
    </p>
  </main>
</Base>
