---
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";

const whatsappGroup = site.whatsappGroup;
---

<Base
  title={`Entrando no Grupo VIP - ${site.name}`}
  description="Redirecionando para o grupo de ofertas de Pokémon TCG no WhatsApp."
>
  <head slot="head">
    <meta http-equiv="refresh" content={`0;url=${whatsappGroup}`} />
  </head>

  <main id="conteudo" class="mx-auto flex min-h-[70vh] max-w-lg flex-col items-center justify-center px-5 py-16 text-center">
    <div class="rounded-sm border border-ink/10 bg-surface p-8 shadow-lg">
      <div class="text-4xl animate-bounce">⚡</div>
      <h1 class="mt-4 font-display text-2xl font-bold text-ink sm:text-3xl">
        Abrindo o WhatsApp...
      </h1>
      <p class="mt-2 text-sm text-muted">
        Você está sendo redirecionado diretamente para o nosso Grupo VIP de ofertas exclusivas.
      </p>

      <div class="mt-6">
        <a
          id="direct-wa-btn"
          class="cta cta-pulse w-full py-3.5 text-base"
          href={whatsappGroup}
          rel="noopener noreferrer"
        >
          Clique aqui se não abrir automaticamente
        </a>
      </div>

      <p class="mt-4 text-xs text-muted">
        Acesso 100% gratuito · Vagas ilimitadas
      </p>
    </div>
  </main>
</Base>

<script is:inline define:vars={{ whatsappGroup }}>
  (function () {
    if (typeof fbq === "function") {
      try {
        fbq("track", "Lead");
        fbq("track", "CompleteRegistration");
      } catch (err) {}
    }
    // Redirecionamento automático imediato
    try {
      window.location.replace(whatsappGroup);
    } catch (e) {
      window.location.href = whatsappGroup;
    }
  })();
</script>
