---
import Base from "../layouts/Base.astro";
import { site } from "../lib/site";

const defaultGroupUrl = site.whatsappGroup;
---

<Base
  title={`Acesso Liberado — ${site.name}`}
  description="Seu acesso ao grupo de ofertas de Pokémon TCG no WhatsApp está liberado."
>
  <main id="conteudo" class="mx-auto flex min-h-[80dvh] max-w-xl flex-col justify-center px-5 py-16 text-center">
    <div>
      <div class="inline-flex items-center gap-2 rounded-full border border-flame/30 bg-surface px-3 py-1 text-xs font-semibold text-flame">
        <span class="inline-block h-2 w-2 rounded-full bg-flame animate-pulse" aria-hidden="true"></span>
        Convite Liberado
      </div>

      <h1 class="mt-3 font-display text-[clamp(1.7rem,6vw,2.8rem)] font-bold leading-tight text-ink">
        Entrar no Grupo de Ofertas
      </h1>

      <p class="measure mx-auto mt-4 text-base leading-relaxed text-muted">
        Seu cadastro foi recebido com sucesso! Toque no botão abaixo para ingressar diretamente no grupo exclusivo de ofertas e promoções de Pokémon TCG.
      </p>

      <div class="mt-8 flex flex-col items-center gap-3">
        <a
          id="group-cta"
          class="cta cta-pulse w-full max-w-md py-3.5 text-base sm:text-lg"
          href={defaultGroupUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path
              fill="currentColor"
              d="M19.05 4.91A9.82 9.82 0 0 0 12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.27-1.38a9.86 9.86 0 0 0 4.77 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.91-7.01Zm-7.01 15.24h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.13.82.84-3.05-.2-.31a8.18 8.18 0 0 1-1.26-4.37c0-4.54 3.7-8.24 8.25-8.24 2.2 0 4.27.86 5.82 2.42a8.18 8.18 0 0 1 2.41 5.83c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.7-.81-.23-.08-.39-.12-.56.12-.17.25-.64.81-.79.97-.14.17-.3.19-.55.06-.25-.12-1.05-.39-2-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.02-.38.11-.51.11-.11.25-.3.37-.44.12-.15.17-.25.25-.41.08-.17.04-.31-.02-.44-.06-.12-.56-1.34-.76-1.84-.2-.48-.41-.42-.56-.42h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.12.17 1.78 2.72 4.32 3.81.6.26 1.08.42 1.44.53.61.19 1.16.16 1.6.1.49-.07 1.47-.6 1.67-1.18.21-.58.21-1.07.14-1.18-.06-.1-.23-.17-.48-.29Z"
            ></path>
          </svg>
          Entrar no Grupo no WhatsApp
        </a>

        <p class="text-xs text-muted">
          Avisos diários de booster, box e cartas em promoção. A compra é feita no vendedor.
        </p>
      </div>

      <p class="mt-8">
        <a class="cta-ghost" href={import.meta.env.BASE_URL}>Voltar à página inicial</a>
      </p>
    </div>
  </main>
</Base>

<script is:inline define:vars={{ defaultGroupUrl }}>
  (function () {
    var cta = document.getElementById("group-cta");
    if (!cta) return;

    var groupUrl = defaultGroupUrl;
    try {
      var stored = JSON.parse(sessionStorage.getItem("tcgLead") || "null");
      if (stored && stored.groupUrl) {
        groupUrl = stored.groupUrl;
      }
    } catch (e) {}

    cta.href = groupUrl;

    if (typeof fbq === "function") {
      try {
        if (sessionStorage.getItem("tcgLeadPixel") !== "1") {
          fbq("track", "Lead");
          sessionStorage.setItem("tcgLeadPixel", "1");
        }
      } catch (err) {}
    }
  })();
</script>
