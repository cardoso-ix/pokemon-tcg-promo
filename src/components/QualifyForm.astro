---
import { site } from "../lib/site";
import { buyOptions } from "../lib/lead";

interface Props {
  heading?: string;
}

const { heading = "Responde em 20 segundos para entrar" } = Astro.props;
const webhook = site.leadWebhook;
const obrigadoHref = `${import.meta.env.BASE_URL}obrigado/`;
const instagramHref = site.instagram;
---

<section id="entrar" class="qualify" aria-labelledby="entrar-titulo">
  <div class="qualify-panel">
    <p class="font-display text-sm text-flame">Só para quem já compra TCG</p>
    <h2 id="entrar-titulo" class="mt-2 font-display text-[clamp(1.45rem,5vw,2.2rem)] font-semibold leading-tight text-ink">
      {heading}
    </h2>
    <p class="measure mt-3 text-sm leading-relaxed text-muted sm:text-base">
      O grupo é de ofertas do Mercado Livre para quem já compra booster, box ou carta. Curiosos ficam de fora.
    </p>

    <form id="qualify-form" class="qualify-form" novalidate>
      <label class="qualify-field">
        <span>Seu nome</span>
        <input name="nome" type="text" autocomplete="given-name" required maxlength="80" placeholder="Como te chamamos" />
      </label>

      <fieldset class="qualify-field">
        <legend>Você já compra Pokémon TCG?</legend>
        <label class="qualify-choice">
          <input type="radio" name="ja_compra" value="sim" required />
          <span>Sim, já compro</span>
        </label>
        <label class="qualify-choice">
          <input type="radio" name="ja_compra" value="nao" required />
          <span>Ainda não compro</span>
        </label>
      </fieldset>

      <fieldset class="qualify-field" id="campo-compra">
        <legend>O que você mais compra?</legend>
        {
          buyOptions.map((option) => (
            <label class="qualify-choice">
              <input type="checkbox" name="o_que_compra" value={option.value} />
              <span>{option.label}</span>
            </label>
          ))
        }
      </fieldset>

      <label class="qualify-field">
        <span>WhatsApp com DDD</span>
        <input
          name="whatsapp"
          type="tel"
          inputmode="numeric"
          autocomplete="tel"
          required
          minlength="10"
          maxlength="15"
          placeholder="11 99999-9999"
        />
      </label>

      <label class="qualify-consent">
        <input type="checkbox" name="lgpd" value="sim" required />
        <span>
          Autorizo o {site.name} a guardar meu WhatsApp para liberar o grupo e ofertas. A compra é no vendedor, não no grupo. Não somos canal oficial Pokémon.
        </span>
      </label>

      <p id="qualify-error" class="qualify-error" hidden></p>

      <button class="cta w-full" type="submit" id="qualify-submit">
        Continuar
      </button>
    </form>
  </div>
</section>

<script is:inline define:vars={{ webhook, obrigadoHref, instagramHref }}>
  (function () {
    var form = document.getElementById("qualify-form");
    var errorEl = document.getElementById("qualify-error");
    var submitBtn = document.getElementById("qualify-submit");
    var buyField = document.getElementById("campo-compra");
    if (!form || !errorEl || !submitBtn) return;

    function goInstagram() {
      window.location.href = instagramHref;
    }

    function showError(message) {
      errorEl.hidden = false;
      errorEl.textContent = message;
    }

    function hideError() {
      errorEl.hidden = true;
      errorEl.textContent = "";
    }

    function digits(value) {
      return String(value || "").replace(/\D/g, "");
    }

    function utm(name) {
      try {
        return new URLSearchParams(window.location.search).get(name) || "";
      } catch (err) {
        return "";
      }
    }

    form.addEventListener("change", function () {
      var selected = form.querySelector('input[name="ja_compra"]:checked');
      if (selected && selected.value === "nao") {
        goInstagram();
        return;
      }
      if (!buyField) return;
      buyField.hidden = false;
    });

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      hideError();

      var data = new FormData(form);
      var jaCompra = String(data.get("ja_compra") || "");
      var whatsapp = digits(data.get("whatsapp"));
      var nome = String(data.get("nome") || "").trim();
      var products = data.getAll("o_que_compra").map(String);

      if (!nome) {
        showError("Escreve seu nome.");
        return;
      }
      if (jaCompra === "nao") {
        goInstagram();
        return;
      }
      if (jaCompra !== "sim") {
        showError("Diz se você já compra TCG.");
        return;
      }
      if (products.length === 0) {
        showError("Marca o que você mais compra.");
        return;
      }
      if (whatsapp.length < 10 || whatsapp.length > 13) {
        showError("WhatsApp inválido. Usa DDD e o número.");
        return;
      }
      if (data.get("lgpd") !== "sim") {
        showError("Precisa autorizar o uso do WhatsApp para continuar.");
        return;
      }
      if (!webhook) {
        showError("O funil ainda não está ligado. Tenta de novo em alguns minutos.");
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Validando…";

      fetch(webhook, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          nome: nome,
          whatsapp: whatsapp,
          ja_compra: jaCompra,
          o_que_compra: products.join(","),
          origem: "landing",
          lgpd: "sim",
          utm_source: utm("utm_source"),
          utm_campaign: utm("utm_campaign"),
        }),
      })
        .then(function (response) {
          return response.json().then(function (payload) {
            return { ok: response.ok, payload: payload || {} };
          });
        })
        .then(function (result) {
          var status = result.payload.status === "quente" ? "quente" : "frio";
          if (!result.ok && !result.payload.status) {
            throw new Error("bad");
          }

          try {
            sessionStorage.setItem(
              "tcgLead",
              JSON.stringify({
                status: status,
                groupUrl: status === "quente" ? result.payload.groupUrl || "" : "",
                ts: Date.now(),
              }),
            );
          } catch (err) {}

          if (status === "quente" && typeof fbq === "function") {
            fbq("track", "Lead");
            try {
              sessionStorage.setItem("tcgLeadPixel", "1");
            } catch (err) {}
          }

          window.location.href = obrigadoHref + "?status=" + encodeURIComponent(status);
        })
        .catch(function () {
          submitBtn.disabled = false;
          submitBtn.textContent = "Continuar";
          showError("Não deu para validar agora. Tenta de novo.");
        });
    });
  })();
</script>
