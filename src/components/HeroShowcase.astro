---
import { asset } from "../lib/site";
---

<figure class="hero-stage">
  <div class="hero-glow" aria-hidden="true"></div>
  <img
    class="hero-lockup"
    src={asset("brand/pokemon-tcg-promo-hero.jpg")}
    alt="Arte 3D do Pokémon TCG Promo com Charizard, Pikachu, Gengar e Mewtwo em volta do logo amarelo com contorno azul, no fundo preto."
    width="1024"
    height="682"
    decoding="async"
    fetchpriority="high"
  />
</figure>
