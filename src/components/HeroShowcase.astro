---
// HeroShowcase.astro - Card Holográfico 3D de Colecionador (Raridade Secreta)
const cardImage = "https://cdn.magicpatterns.com/patterns/generated-images/4ed4fd82-8115-47af-aa32-d84325d4f77e.jpg";
---

<div class="relative mx-auto w-[250px] sm:w-[290px] lg:w-[330px]">
  {/* Auras de Fogo e Eletricidade */}
  <div aria-hidden="true" class="absolute -left-10 top-6 h-56 w-56 rounded-full bg-orange-500/35 blur-3xl pointer-events-none"></div>
  <div aria-hidden="true" class="absolute -right-10 bottom-4 h-56 w-56 rounded-full bg-cyan-400/30 blur-3xl pointer-events-none"></div>
  <div aria-hidden="true" class="absolute inset-x-6 -bottom-6 h-12 rounded-full bg-amber-400/25 blur-2xl pointer-events-none"></div>

  {/* Card Metálico com Efeito Float */}
  <div class="relative rounded-[22px] bg-gradient-to-br from-amber-200 via-yellow-500 to-amber-700 p-[3.5px] shadow-[0_25px_60px_rgba(0,0,0,0.85),0_0_40px_rgba(250,204,21,0.35)] animate-float">
    <div class="relative aspect-[5/7] overflow-hidden rounded-[18px] bg-[#070d1e]">
      
      {/* Imagem de Alta Resolução Charizard & Pikachu */}
      <img
        src={cardImage}
        alt="Carta holográfica rara do Pokémon TCG Promo com Charizard e Pikachu realista"
        class="w-full h-full object-cover select-none"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />

      {/* Camada Holográfica Foil Arco-íris */}
      <div aria-hidden="true" class="holo-foil absolute inset-0 pointer-events-none opacity-65"></div>

      {/* Top Header do Card */}
      <div class="absolute inset-x-3 top-3 flex items-center justify-between rounded-xl bg-[#070d1e]/85 px-3 py-1.5 ring-1 ring-amber-300/40 backdrop-blur-md">
        <span class="font-display text-[11px] font-bold tracking-wide text-white sm:text-xs">
          Charizard & Pikachu
        </span>
        <span class="font-display text-[11px] font-bold text-amber-300 sm:text-xs">HP 330</span>
      </div>

      {/* Bottom Footer do Card */}
      <div class="absolute inset-x-3 bottom-3 flex items-center justify-between rounded-xl bg-[#070d1e]/85 px-3 py-1.5 ring-1 ring-amber-300/40 backdrop-blur-md">
        <span class="font-mono text-[10px] text-slate-300">PROMO · 001/151</span>
        <span class="text-amber-300 text-xs tracking-tighter">★★★</span>
      </div>
    </div>
  </div>

  {/* Badge Flutuante Raridade Secreta */}
  <div class="absolute -top-3 -right-3 rotate-6 sm:-top-4 sm:-right-4">
    <div class="relative overflow-hidden rounded-full bg-gradient-to-r from-amber-200 via-yellow-400 to-amber-500 px-3.5 py-1.5 shadow-[0_0_24px_rgba(255,210,63,0.6)] ring-1 ring-white/60">
      <span aria-hidden="true" class="pointer-events-none absolute inset-y-0 left-0 w-1/3 animate-shimmer bg-gradient-to-r from-transparent via-white/70 to-transparent"></span>
      <span class="relative flex items-center gap-1 font-display text-[10px] sm:text-[11px] font-bold uppercase tracking-wider text-amber-950">
        <span>✨</span> Raridade Secreta
      </span>
    </div>
  </div>
</div>
