---
import JoinButton from "./JoinButton.astro";
import { products } from "../lib/products";
---

<section class="border-t border-ink/10" aria-labelledby="radar-titulo">
  <div class="mx-auto max-w-xl px-5 py-14 sm:py-16 lg:max-w-2xl lg:py-20">
    <div>
      <h2 id="radar-titulo" class="font-display text-[clamp(1.55rem,5.4vw,2.6rem)] font-semibold leading-tight">
        Ofertas que estão no radar
      </h2>
    </div>

    <ul class="mt-10 flex flex-col gap-12 lg:mt-12 lg:gap-16">
      {
        products.map((item) => (
          <li>
            <article class="flex flex-col">
              <div class="radar-photo min-h-52 rounded-lg px-3 py-6 sm:min-h-64">
                <img
                  src={item.src}
                  alt={item.alt}
                  width="800"
                  height="1000"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <h3 class="mt-4 font-display text-xl font-semibold leading-tight sm:text-2xl">{item.name}</h3>
              <p class="mt-1 font-display text-sm text-accent">{item.line}</p>
              <p class="mt-2 text-muted">{item.detail}</p>
              <div class="mt-5">
                <JoinButton class="w-full" href={item.href} label="Pedir no WhatsApp" />
              </div>
            </article>
          </li>
        ))
      }
    </ul>
  </div>
</section>
